# =====================================================================
# ULTRON AI ASSISTANT - ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================
# Copy this file to '.env' and fill in your API keys and preferences.
# NEVER commit your actual '.env' file containing real secrets to git!

# ---------------------------------------------------------------------
# 1. LLM BRAIN & REASONING ENGINES
# ---------------------------------------------------------------------
# Google Gemini API Key (Primary brain for chat, reasoning, and tool calling)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (High-speed STT transcription and fast inference)
# Get your free key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# xAI API Key (Optional - for Grok models)
XAI_API_KEY=your_xai_api_key_here

# ---------------------------------------------------------------------
# 2. EMAIL INTEGRATION (GMAIL AUTOMATION)
# ---------------------------------------------------------------------
# Primary Gmail Account (for sending & reading emails automatically)
GMAIL_EMAIL=your_email@gmail.com

# Google 16-character App Password (NOT your normal Gmail password)
# Generate one at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your_16_char_app_password

# Secondary Gmail Account (Optional - for dual account switching)
GMAIL_EMAIL_2=your_secondary_email@gmail.com
GMAIL_APP_PASSWORD_2=your_secondary_app_password

# ---------------------------------------------------------------------
# 3. TEXT-TO-SPEECH (TTS) & VOICE SETTINGS
# ---------------------------------------------------------------------
# TTS Engine: "edge" (Microsoft Edge Neural, high quality, free) or "piper" (local offline)
ULTRON_TTS_ENGINE=edge

# Microsoft Edge Neural Voice selection
# Examples: en-US-ChristopherNeural, en-US-BrianMultilingualNeural, en-US-GuyNeural
ULTRON_EDGE_VOICE=en-US-ChristopherNeural

# Voice modulation tuning
ULTRON_EDGE_PITCH=-16Hz
ULTRON_EDGE_RATE=-15%

# ---------------------------------------------------------------------
# 4. SPEECH-TO-TEXT (STT) SETTINGS
# ---------------------------------------------------------------------
# Free Google Indian English recognition fallback (1 = enabled, 0 = disabled)
ULTRON_USE_GOOGLE_STT=1

# Gemini STT Model for complex audio processing
ULTRON_GEMINI_STT_MODEL=gemini-2.5-flash

# Groq Whisper Model for instant transcription
ULTRON_GROQ_STT_MODEL=whisper-large-v3-turbo
